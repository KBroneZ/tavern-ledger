{
  "about": "Every key of an uploaded game record, per level (T-104h, D-047). The parser's report (crates/bg-parser/src/report.rs) and the desktop app's record (crates/uploader) must write exactly these, and upload-game's validator must check exactly these: cargo test fails when the parser writes a key missing here, and the function refuses to start when validate.ts checks a different set. Maps whose keys are data (card_names, shop_tribes, start_health, health_after, skin_parents) are not levels.",
  "keys": {
    "record": ["index", "parser", "report", "saved_at", "session"],
    "parser": ["revision", "version"],
    "report": [
      "build",
      "card_names",
      "discovers",
      "final_health",
      "final_place",
      "game_type",
      "hero",
      "hero_select",
      "index",
      "lobby",
      "local_player_id",
      "not_in_log",
      "old_god",
      "problems",
      "rounds",
      "shop",
      "shop_tribes",
      "skin_parents",
      "start_health",
      "status",
      "teammate_hero",
      "teammate_player_id",
      "warnings"
    ],
    "report.lobby[]": ["duo_team", "final_health", "final_place", "hero", "player_id", "trinkets", "triples"],
    "report.lobby[].triples[]": ["count", "turn"],
    "report.lobby[].trinkets[]": ["dbf_id", "slot", "turn"],
    "report.rounds[]": ["entries", "health_after", "number", "opponents", "own_health_after", "replay", "result"],
    "report.rounds[].entries[]": ["board", "hero", "player_id", "side", "values"],
    "report.rounds[].entries[].values": ["beetle_atk", "beetle_health", "blood_gem_atk", "blood_gem_health", "knights_dead", "spell_atk", "spell_health", "undead_atk"],
    "report.rounds[].entries[].board[]": ["atk", "card_id", "gift_unknown", "gifts", "golden", "health", "keywords", "position"],
    "report.rounds[].replay": ["complete", "events", "minions", "start"],
    "report.rounds[].replay.minions[]": ["atk", "card_id", "gift_unknown", "gifts", "golden", "health", "keywords", "position", "side"],
    "report.rounds[].replay.events[]": ["amount", "atk", "attacker", "card_id", "defender", "health", "hero", "kind", "minion", "on", "side", "source", "trigger"],
    "report.shop": ["actions", "end_ms", "ended", "start_ms", "tier_ups", "turns"],
    "report.shop.turns[]": ["actions", "buy_gold", "buys", "end_ms", "extra_gold", "free_refreshes", "free_rolls", "freezes", "gold", "gold_spent", "offers", "passes", "rolls", "sell_gold", "sells", "spell_buys", "spell_gold", "start_ms", "tier", "turn"],
    "report.shop.turns[].offers[]": ["card_id", "frozen", "roll"],
    "report.shop.tier_ups[]": ["tier", "turn"],
    "report.shop.actions[]": ["kind", "ms", "turn"],
    "report.hero_select": ["offered", "picked", "rerolls"],
    "report.discovers[]": ["offered", "picked", "source", "turn"],
    "report.discovers[].offered[]": ["card_id", "gift"]
  }
}
