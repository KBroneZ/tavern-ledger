# Copy to web/.env (ignored by git). Only the project URL and the public
# (anon or publishable) key go here: the build refuses anything else.
# Local stack: both values come from `npx supabase status`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Sign-up form on /signin/: only with exactly "true". Unset or "false" shows
# "Sign-up is not open yet" (the hosted project keeps sign-ups closed until
# the owner opens them). The local stack allows sign-ups.
PUBLIC_SIGNUPS_OPEN=true
