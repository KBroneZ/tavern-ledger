{
  "name": "tavern-ledger-web",
  "private": true,
  "description": "Tavern Ledger website: static Astro site that talks to Supabase from the browser.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "node tools/prepare-sim.ts --if-missing && astro dev",
    "build": "node tools/prepare-sim.ts && astro build",
    "preview": "astro preview",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:dist": "node --test \"test/build/*.test.ts\"",
    "test:local": "node --test --test-concurrency=1 \"test/local/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "astro": "7.3.8"
  }
}
