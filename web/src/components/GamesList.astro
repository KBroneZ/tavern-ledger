---
// The games list (/games/, /games/?id=…) (T-503, D-073): filters in a plain
// GET form (the address is the state, so a link opens the same list), and
// one page of games drawn by the script into the reserved #list-body.
import "../styles/data.css";
import "../styles/dash.css";
import { href } from "../lib/i18n.ts";
import { t } from "../lib/data/strings.ts";
import { PLACE_FILTERS } from "../lib/data/filters.ts";
import { SAVED_LIMIT } from "../lib/pwa/saved.ts";
import StateBlock from "./data/StateBlock.astro";
import Switch from "./data/Switch.astro";
import DataScript from "./data/DataScript.astro";

const places = PLACE_FILTERS.map((p) => [p, t(`list.place.${p}`)]);
---

<div class="dash" id="list" aria-busy="true">
  <header class="data-head dash-head">
    <div>
      <p class="kicker"><a id="list-back" href={href("/me/")}>{t("list.back.own")}</a></p>
      <h1 id="list-title">{t("list.title")}</h1>
    </div>
    <Switch kind="detail" />
  </header>
  <p class="visually-hidden" id="list-status" role="status" aria-live="polite"></p>
  <form class="list-filters" id="list-filters" method="get" action={href("/games/")} aria-label={t("list.filters")}>
    <label>
      {t("list.mode")}
      <select name="mode" id="list-mode">
        <option value="all">{t("list.mode.all")}</option>
        <option value="solo">{t("mode.solo")}</option>
        <option value="duos">{t("mode.duos")}</option>
      </select>
    </label>
    <label>
      {t("list.hero")}
      <select name="hero" id="list-hero">
        <option value="">{t("list.hero.any")}</option>
      </select>
    </label>
    <label>
      {t("list.from")}
      <input type="date" name="from" id="list-from" />
    </label>
    <label>
      {t("list.to")}
      <input type="date" name="to" id="list-to" />
    </label>
    <label>
      {t("list.place")}
      <select name="place" id="list-place">
        {places.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </label>
    <div class="list-actions">
      <button class="tb tb-common" type="submit" id="list-apply" disabled>{t("list.apply")}</button>
      <a class="tb tb-small" href={href("/games/")} id="list-reset">{t("list.reset")}</a>
    </div>
  </form>
  <div class="dash-body" id="list-body">
    <StateBlock kind="loading" lines={12} />
  </div>
  <!-- "Keep my last games on this device" (T-637): src/scripts/savedGames.ts shows it on your own list, where the browser can keep files. -->
  <section class="saved" id="saved" aria-labelledby="saved-title" hidden>
    <h2 id="saved-title">{t("saved.title")}</h2>
    <p>{t("saved.note")}</p>
    <label class="saved-toggle">
      <input type="checkbox" id="saved-on" />
      <span>{t("saved.on", { count: SAVED_LIMIT })}</span>
    </label>
    <p class="saved-hint">{t("saved.hint")}</p>
    <p id="saved-count" role="status" aria-live="polite"></p>
    <p><button class="tb tb-small" type="button" id="saved-erase">{t("saved.erase")}</button></p>
  </section>
</div>

<DataScript />
<script src="../scripts/games.ts"></script>
<script src="../scripts/savedGames.ts"></script>
