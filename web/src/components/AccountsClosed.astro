---
// Shown in place of sign-in, account and profile while there is no hosted
// backend (readConfig() is null): plain text, no form and no script.
import { href } from "../lib/i18n.ts";
import { st } from "../lib/site/strings.ts";

interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<h1>{heading}</h1>
<aside class="status" aria-label={st("closed.label")}>
  <p>
    <strong>{st("closed.strong")}</strong> {st("closed.body")}
  </p>
  <p>
    {st("closed.read.before")} <a href={href("/")}>{st("closed.read.project")}</a>{st("closed.read.middle")} <a
      href={href("/privacy/")}>{st("closed.read.privacy")}</a
    > {st("closed.read.and")} <a href={href("/terms/")}>{st("closed.read.terms")}</a>.
  </p>
</aside>
