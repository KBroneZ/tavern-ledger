---
import { MIN_PASSWORD_LENGTH } from "../lib/auth.ts";
import { confirmPhrase } from "../lib/deleteAccount.ts";
import { href } from "../lib/i18n.ts";
import { at } from "../lib/account/strings.ts";
---

<h1 id="account-heading">{at("account.title")}</h1>
<p class="message" id="page-message" role="status" aria-live="polite">{at("account.loading")}</p>

<section id="signed-out" hidden>
  <p id="signed-out-message">
    {at("account.signedOut.before")} <a href={href("/signin/")}>{at("account.signedOut.link")}</a> {at("account.signedOut.after")}
  </p>
</section>

<section id="set-password" class="panel" aria-labelledby="set-password-heading" hidden>
  <h2 id="set-password-heading">{at("account.setPassword")}</h2>
  <form id="set-password-form" novalidate>
    <label>
      {at("account.newPassword")}
      <span class="hint">{at("signin.hint.length", { min: MIN_PASSWORD_LENGTH })}</span>
      <input
        type="password"
        name="password"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
      />
    </label>
    <label>
      {at("account.repeat")}
      <input type="password" name="repeat" autocomplete="new-password" required />
    </label>
    <button type="submit">{at("account.savePassword")}</button>
    <p class="message" id="set-password-message" role="status" aria-live="polite"></p>
  </form>
</section>

<section id="deleted" hidden>
  <p id="deleted-message">{at("account.deleted")}</p>
</section>

<div id="signed-in" hidden>
  <p class="meta">{at("account.signedInAs.before")} <span id="account-email" class="mono"></span>.</p>

  <div class="panels">
    <section class="panel" aria-labelledby="profile-heading">
      <h2 id="profile-heading">{at("account.profile")}</h2>
      <form id="profile-form" novalidate>
        <label>
          {at("account.displayName")}
          <span class="hint">{at("account.displayName.hint")}</span>
          <input type="text" name="display_name" maxlength="32" autocomplete="nickname" />
        </label>
        <label class="check">
          <input type="checkbox" name="is_public" />
          <span>
            {at("account.public")}
            <span class="hint">
              {at("account.public.hint.before")}
              <a href={href("/leaderboards/")}>{at("account.public.hint.link")}</a>{at("account.public.hint.after")}
            </span>
          </span>
        </label>
        <button type="submit">{at("account.save")}</button>
        <p class="message" id="profile-message" role="status" aria-live="polite"></p>
      </form>
      <p id="public-link-row" class="meta" hidden>
        {at("account.publicPage")} <a id="public-link" href={href("/")}></a>
      </p>
    </section>

    <section class="panel" aria-labelledby="export-heading">
      <h2 id="export-heading">{at("account.data")}</h2>
      <p>{at("account.data.body")}</p>
      <button type="button" id="export-button" class="secondary">{at("account.download")}</button>
      <p class="message" id="export-message" role="status" aria-live="polite"></p>
    </section>

    <section class="panel" aria-labelledby="community-heading">
      <h2 id="community-heading">{at("account.community")}</h2>
      <form id="community-form" novalidate>
        <label class="check">
          <input type="checkbox" name="hero_stats" />
          <span>
            {at("account.community.label")}
            <span class="hint">
              {at("account.community.hint.before")}
              <a href={href("/heroes/")}>{at("account.community.hint.link")}</a>{at("account.community.hint.after")}
              <a href={href("/privacy/#community-hero-stats")}>{at("account.community.how")}</a>.
            </span>
          </span>
        </label>
        <button type="submit">{at("account.save")}</button>
        <p class="message" id="community-message" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>

  <section class="panel danger" aria-labelledby="delete-heading">
    <h2 id="delete-heading">{at("account.delete")}</h2>
    <p>{at("account.delete.body")}</p>
    <form id="delete-form" novalidate>
      <label>
        <span>{at("account.delete.type.before")} <span class="mono">{confirmPhrase()}</span> {at("account.delete.type.after")}</span>
        <input type="text" name="confirm" autocomplete="off" spellcheck="false" />
      </label>
      <div id="reauth" class="callout" hidden>
        <label>
          {at("account.reauth")}
          <span class="hint">{at("account.reauth.hint")}</span>
          <input type="password" name="password" autocomplete="current-password" />
        </label>
      </div>
      <button type="submit" class="danger">{at("account.delete.submit")}</button>
      <p class="message" id="delete-message" role="status" aria-live="polite"></p>
    </form>
  </section>

  <p><button type="button" id="signout-button" class="secondary">{at("account.signOut")}</button></p>
</div>

<script src="../scripts/account.ts"></script>
