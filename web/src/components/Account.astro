---
import { MIN_PASSWORD_LENGTH } from "../lib/auth.ts";
import { confirmPhrase } from "../lib/deleteAccount.ts";
import { href } from "../lib/i18n.ts";
import { at } from "../lib/account/strings.ts";
import More from "./ui/More.astro";
import Captcha from "./Captcha.astro";
---

<h1 id="account-heading">{at("account.title")}</h1>
<p class="message" id="page-message" role="status" aria-live="polite">{at("account.loading")}</p>

<section id="signed-out" hidden>
  <p id="signed-out-message">
    {at("account.signedOut.before")} <a href={href("/signin/")}>{at("account.signedOut.link")}</a> {at("account.signedOut.after")}
  </p>
</section>

<section id="set-password" class="panel" aria-labelledby="set-password-heading" hidden>
  <h2 id="set-password-heading">{at("account.setPassword")}</h2>
  <form id="set-password-form" novalidate>
    <label>
      {at("account.newPassword")}
      <span class="hint">{at("signin.hint.length", { min: MIN_PASSWORD_LENGTH })}</span>
      <input
        type="password"
        name="password"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
      />
    </label>
    <label>
      {at("account.repeat")}
      <input type="password" name="repeat" autocomplete="new-password" required />
    </label>
    <button class="tb tb-common" type="submit">{at("account.savePassword")}</button>
    <p class="message" id="set-password-message" role="status" aria-live="polite"></p>
  </form>
</section>

<section id="deleted" hidden>
  <p id="deleted-message">{at("account.deleted")}</p>
</section>

<div id="signed-in" hidden>
  <p class="meta">{at("account.signedInAs.before")} <span id="account-email" class="mono"></span>.</p>

  {/* One-time notice for accounts made before the training use (T-651); the script shows it. */}
  <aside class="panel" id="training-notice" aria-label={at("account.training")} hidden>
    <p>
      {at("account.training.notice")}{" "}
      <a href="#training-heading">{at("account.training.notice.link")}</a>.
    </p>
    <button class="tb tb-small" type="button" id="training-notice-dismiss">{at("account.training.notice.dismiss")}</button>
  </aside>

  <div class="panels">
    <section class="panel" aria-labelledby="profile-heading">
      <h2 id="profile-heading">{at("account.profile")}</h2>
      <form id="profile-form" novalidate>
        <div class="field">
          <label for="display-name">{at("account.displayName")}</label>
          <span class="hint" id="display-name-hint">{at("account.displayName.hint")}</span>
          <More context={at("account.displayName")}>
            <p>{at("account.displayName.more")}</p>
          </More>
          <input
            type="text"
            id="display-name"
            name="display_name"
            maxlength="32"
            autocomplete="nickname"
            aria-describedby="display-name-hint"
          />
        </div>
        <div class="check">
          <input class="toggle" type="checkbox" id="is-public" name="is_public" aria-describedby="is-public-hint" />
          <div>
            <label for="is-public">{at("account.public")}</label>
            <p class="hint" id="is-public-hint">{at("account.public.hint")}</p>
            <More context={at("account.public")}>
              <p>
                {at("account.public.more.before")}{" "}
                <a href={href("/leaderboards/")}>{at("account.public.more.link")}</a>{at("account.public.more.after")}
              </p>
            </More>
          </div>
        </div>
        <button class="tb tb-common" type="submit">{at("account.save")}</button>
        <p class="message" id="profile-message" role="status" aria-live="polite"></p>
      </form>
      <p id="public-link-row" class="meta" hidden>
        {at("account.publicPage")} <a id="public-link" href={href("/")}></a>
      </p>
    </section>

    <section class="panel" aria-labelledby="community-heading">
      <h2 id="community-heading">{at("account.community")}</h2>
      <form id="community-form" novalidate>
        <div class="check">
          <input class="toggle" type="checkbox" id="hero-stats" name="hero_stats" aria-describedby="hero-stats-hint" />
          <div>
            <label for="hero-stats">{at("account.community.label")}</label>
            <p class="hint" id="hero-stats-hint">
              {at("account.community.hint.before")}{" "}
              <a href={href("/heroes/")}>{at("account.community.hint.link")}</a>{at("account.community.hint.after")}
            </p>
            <More context={at("account.community")}>
              <p>
                {at("account.community.more")}{" "}
                <a href={href("/privacy/#community-hero-stats")}>{at("account.community.how")}</a>.
              </p>
            </More>
          </div>
        </div>
        <button class="tb tb-common" type="submit">{at("account.save")}</button>
        <p class="message" id="community-message" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="panel" aria-labelledby="simulator-heading">
      <h2 id="simulator-heading">{at("account.simulator")}</h2>
      <form id="simulator-form" novalidate>
        <div class="check">
          <input
            class="toggle"
            type="checkbox"
            id="improve-simulator"
            name="improve_simulator"
            aria-describedby="improve-simulator-hint"
          />
          <div>
            <label for="improve-simulator">{at("account.simulator.label")}</label>
            <p class="hint" id="improve-simulator-hint">{at("account.simulator.hint")}</p>
            <More context={at("account.simulator")}>
              <p>
                {at("account.simulator.more")}{" "}
                <a href={href("/privacy/#improving-the-simulator")}>{at("account.simulator.how")}</a>.
              </p>
            </More>
          </div>
        </div>
        <button class="tb tb-common" type="submit">{at("account.save")}</button>
        <p class="message" id="simulator-message" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="panel" aria-labelledby="training-heading">
      <h2 id="training-heading">{at("account.training")}</h2>
      <form id="training-form" novalidate>
        <div class="check">
          <input
            class="toggle"
            type="checkbox"
            id="train-model"
            name="train_model"
            aria-describedby="train-model-hint"
          />
          <div>
            <label for="train-model">{at("account.training.label")}</label>
            <p class="hint" id="train-model-hint">{at("account.training.hint")}</p>
            <More context={at("account.training")}>
              <p>
                {at("account.training.more")}{" "}
                <a href={href("/privacy/#training-the-expected-place-model")}>{at("account.training.how")}</a>.
              </p>
            </More>
          </div>
        </div>
        <button class="tb tb-common" type="submit">{at("account.save")}</button>
        <p class="message" id="training-message" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="panel" aria-labelledby="export-heading">
      <h2 id="export-heading">{at("account.data")}</h2>
      <p>{at("account.data.body")}</p>
      <More context={at("account.data")}>
        <p>{at("account.data.more")}</p>
      </More>
      <button class="tb tb-common" type="button" id="export-button">{at("account.download")}</button>
      <p class="message" id="export-message" role="status" aria-live="polite"></p>
    </section>
  </div>

  <section class="panel danger" aria-labelledby="delete-heading">
    <h2 id="delete-heading">{at("account.delete")}</h2>
    <p>{at("account.delete.body")}</p>
    <form id="delete-form" novalidate>
      <label>
        <span>{at("account.delete.type.before")} <span class="mono">{confirmPhrase()}</span> {at("account.delete.type.after")}</span>
        <input type="text" name="confirm" autocomplete="off" spellcheck="false" />
      </label>
      <div id="reauth" class="callout" hidden>
        <label>
          {at("account.reauth")}
          <span class="hint">{at("account.reauth.hint")}</span>
          <input type="password" name="password" autocomplete="current-password" />
        </label>
        <Captcha />
      </div>
      <button class="tb tb-danger" type="submit">{at("account.delete.submit")}</button>
      <p class="message" id="delete-message" role="status" aria-live="polite"></p>
    </form>
  </section>

  <p><button class="tb tb-small" type="button" id="signout-button">{at("account.signOut")}</button></p>
</div>

<script src="../scripts/account.ts"></script>
