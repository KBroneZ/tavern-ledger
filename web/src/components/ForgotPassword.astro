---
import { href } from "../lib/i18n.ts";
import { at } from "../lib/account/strings.ts";
---

<h1>{at("forgot.title")}</h1>
<p class="meta">{at("forgot.meta")}</p>

<section class="panel" aria-labelledby="reset-heading">
  <h2 id="reset-heading">{at("forgot.heading")}</h2>
  <form id="reset-form" novalidate>
    <label>
      {at("signin.email")}
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <button class="tb tb-common" type="submit" disabled>{at("forgot.submit")}</button>
    <p class="message" id="reset-message" role="status" aria-live="polite"></p>
  </form>
</section>

<p><a href={href("/signin/")}>{at("forgot.back")}</a></p>

<script src="../scripts/forgot.ts"></script>
