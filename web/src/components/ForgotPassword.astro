<h1>Forgot password</h1>
<p class="meta">
  Enter the email of your account. We send a link to choose a new password; open it in this
  browser.
</p>

<section class="panel" aria-labelledby="reset-heading">
  <h2 id="reset-heading">Get a reset link</h2>
  <form id="reset-form" novalidate>
    <label>
      Email
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <button type="submit" disabled>Send the link</button>
    <p class="message" id="reset-message" role="status" aria-live="polite"></p>
  </form>
</section>

<p><a href="/signin/">Back to sign in</a></p>

<script src="../scripts/forgot.ts"></script>
