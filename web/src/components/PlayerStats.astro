---
// The heroes page (/player-heroes/) and the records page (/curious/)
// (T-505), for the owner or, with ?id=…, a public profile: a static frame
// with reserved room; the script reads the data API in the browser and
// draws one panel per mode into #pp-body in one go (CLS 0, D-073).
import "../styles/data.css";
import "../styles/dash.css";
import "../styles/player.css";
import { href } from "../lib/i18n.ts";
import { t } from "../lib/data/strings.ts";
import Switch from "./data/Switch.astro";
import DataScript from "./data/DataScript.astro";
import StateBlock from "./data/StateBlock.astro";

interface Props {
  page: "heroes" | "curious";
}

const { page } = Astro.props;
const kicker = page === "heroes" ? t("player.heroes.kicker") : t("player.curious.kicker");
const title = page === "heroes" ? t("player.heroes.title.own") : t("player.curious.title.own");
---

<div class="dash" id="pp" data-page={page} aria-busy="true">
  <header class="data-head dash-head">
    <div>
      <p class="kicker"><a id="pp-back" href={href("/me/")}>{t("player.back.own")}</a></p>
      <h1 id="pp-title">{title}</h1>
    </div>
    <div class="dash-switches is-off" id="pp-switches">
      <Switch kind="mode" controls="pp-modes" />
      <Switch kind="detail" />
    </div>
  </header>
  <p class="visually-hidden" id="pp-status" role="status" aria-live="polite"></p>
  <div class="dash-body" id="pp-body">
    <div id="pp-note"></div>
    <div id="pp-gate" hidden></div>
    <div class="mode-panels" id="pp-modes">
      <div class="dash-skeleton">
        {page === "curious" && (
          <div class="tiles">
            <StateBlock kind="loading" lines={4} />
            <StateBlock kind="loading" lines={4} />
            <StateBlock kind="loading" lines={4} />
            <StateBlock kind="loading" lines={4} />
          </div>
        )}
        <StateBlock kind="loading" lines={12} />
      </div>
    </div>
    <div id="pp-about"></div>
  </div>
</div>

<DataScript />
<script src="../scripts/playerStats.ts"></script>
