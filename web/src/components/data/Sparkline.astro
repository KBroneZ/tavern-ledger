---
// A small line of values over time with the latest point lit. In a stat
// tile it is decorative (the tile says the value); as a chart it has a
// title, a description, best and worst labels and a table.
import { ordinal, sparkline } from "../../lib/data/format.ts";
import { t } from "../../lib/data/strings.ts";
import Fold from "./Fold.astro";
import StateBlock from "./StateBlock.astro";

interface Props {
  values: (number | null)[];
  min: number;
  max: number;
  /** Lower is better (place): put min on top. */
  invert?: boolean;
  /** "tile": decorative, no labels. "chart": titled, labelled, with a table. */
  variant?: "tile" | "chart";
  /** Value labels in the chart's table (place: 1st, 2nd…). */
  places?: boolean;
  id?: string;
}

const { values, min, max, invert = false, variant = "tile", places = false, id = "spark" } = Astro.props;
const chart = variant === "chart";
const width = chart ? 300 : 120;
const height = chart ? 72 : 28;
const left = chart ? 30 : 4;
const right = 6;
const line = sparkline(values, { width: width - left - right, height, min, max, invert });
// Lit only when the latest game has a value: an older point is not "now".
const last = line.points.at(-1)?.index === values.length - 1 ? line.points.at(-1) : undefined;
const label = (v: number) => (places ? ordinal(v) : String(v));
const topValue = invert ? min : max;
const bottomValue = invert ? max : min;
---

{
  chart && values.length === 0 ? (
    <StateBlock kind="empty" title={t("chart.trend.title")} />
  ) : chart ? (
    <figure class="chart chart-trend">
      <figcaption>
        <p class="chart-title" id={`${id}-title`}>{t("chart.trend.title")}</p>
        <p class="chart-desc" id={`${id}-desc`}>{t("chart.trend.desc", { count: values.length })}</p>
      </figcaption>
      <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`}>
        <line class="grid" x1={left} x2={width - right} y1="1" y2="1" />
        <line class="grid" x1={left} x2={width - right} y1={height - 1} y2={height - 1} />
        <text x={left - 6} y="5" text-anchor="end">{label(topValue)}</text>
        <text x={left - 6} y={height + 3} text-anchor="end">{label(bottomValue)}</text>
        <g transform={`translate(${left} 0)`}>
          <path class="spark-line" d={line.path} />
          {line.points.map((p) => (
            <g class="mark">
              <title>{`${t("chart.trend.col.game")} ${p.index + 1}: ${label(p.value)}`}</title>
              <circle class="hit" cx={p.x} cy={p.y} r="8" />
            </g>
          ))}
          {last && <circle class="spark-end" cx={last.x} cy={last.y} r="4.5" />}
        </g>
      </svg>
      <Fold summary={t("chart.table")} context={t("chart.trend.title")} compact>
        <table class="dtable">
          <thead>
            <tr>
              <th scope="col">{t("chart.trend.col.game")}</th>
              <th scope="col" class="num">{t("chart.trend.col.place")}</th>
            </tr>
          </thead>
          <tbody>
            {values.map((v, i) => (
              <tr>
                <td>{i + 1}</td>
                <td class="num">{v === null ? t("value.none") : label(v)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Fold>
    </figure>
  ) : (
    <svg class="tile-spark" viewBox={`0 0 ${width} ${height}`} width={width} height={height} aria-hidden="true" focusable="false">
      <g transform={`translate(${left} 0)`}>
        <path class="spark-line" d={line.path} />
        {last && <circle class="spark-end" cx={last.x} cy={last.y} r="4" />}
      </g>
    </svg>
  )
}
