---
import "../styles/global.css";
import { contentSecurityPolicy, readConfig, WASM_PAGES } from "../lib/config.ts";
import { basePath, href, lang, LANGS, pathIn, type Lang } from "../lib/i18n.ts";
import { st } from "../lib/site/strings.ts";

interface Props {
  title: string;
  description: string;
  /** Pages about one account are kept out of search engines. */
  noindex?: boolean;
  /** "home" is full width, "reading" one column of about 68 characters. */
  layout?: "home" | "page" | "reading";
  /** False on a page built in English only (the style page): no switch, no alternates. */
  translated?: boolean;
}

const { title, description, noindex = false, layout = "page", translated = true } = Astro.props;
// Fails the build if only one setting is given or the key is not the public
// one; null means accounts are closed (no backend).
const config = readConfig(import.meta.env);
// Dev mode injects styles from JavaScript, which the policy would block; the
// built site (and `npm run preview`) always carries it.
// The simulator page alone may also compile WebAssembly (D-090).
const wasm = WASM_PAGES.includes(Astro.url.pathname);
const csp = import.meta.env.PROD ? contentSecurityPolicy(config?.url ?? null, { wasm }) : null;
// The page's language was set by the page (setLang) before the layout renders.
const pageLang: Lang = lang();
const other: Lang = pageLang === "en" ? "es" : "en";
const path = Astro.url.pathname;
// The menu marks the current page by its path without the language prefix.
const base = basePath(path);
// Pages kept out of search engines (404, sign-in, account) name no canonical
// address and no alternates; the others name both languages (T-508, D-086).
const canonical = noindex ? null : new URL(path, Astro.site).href;
const alternates = noindex || !translated ? [] : LANGS.map((l) => ({ lang: l, href: new URL(pathIn(base, l), Astro.site).href }));
const xDefault = alternates.find((a) => a.lang === "en")?.href;
// The language script (public/lang.js) needs scripts: only when accounts are open.
const languageScript = config !== null && translated;
const current = (match: boolean) => (match ? "page" : undefined);
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="utf-8" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {languageScript && <script is:inline src="/lang.js"></script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      layout === "home" && (
        <link
          rel="preload"
          href="/fonts/bricolage-grotesque-latin-wdth-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <title>{title} · Tavern Ledger</title>
  </head>
  <body>
    <a class="skip" href="#main">{st("layout.skip")}</a>
    <header class="masthead">
      <a class="brand" href={href("/")}>
        <span class="mark" aria-hidden="true"></span>
        <span>Tavern Ledger</span>
      </a>
      <nav aria-label={st("layout.nav")}>
        <a href={href("/")} aria-current={current(base === "/")}>{st("layout.home")}</a>
        <a href={href("/privacy/")} aria-current={current(base.startsWith("/privacy"))}>{st("layout.privacy")}</a>
        {config && (
          <>
            <a href={href("/leaderboards/")} aria-current={current(base.startsWith("/leaderboards"))}>{st("layout.leaderboards")}</a>
            <a href={href("/heroes/")} aria-current={current(base.startsWith("/heroes"))}>{st("layout.heroes")}</a>
            <a href={href("/me/")} aria-current={current(base.startsWith("/me") || base.startsWith("/games"))}>{st("layout.games")}</a>
            <a href={href("/simulator/")} aria-current={current(base.startsWith("/simulator"))}>{st("layout.simulator")}</a>
            {/* public/lang.js marks <html data-auth>, so only the right one shows (T-513). */}
            <a class="nav-signin" href={href("/signin/")} aria-current={current(base.startsWith("/signin"))}>{st("layout.signin")}</a>
            <a class="nav-account" href={href("/account/")} aria-current={current(base.startsWith("/account"))}>{st("layout.account")}</a>
          </>
        )}
        {
          translated && (
            <a
              class="lang-switch"
              href={pathIn(base, other)}
              hreflang={other}
              lang={other}
              data-lang-switch={other}
              aria-label={st("layout.switch.label")}
            >
              {st("layout.switch")}
            </a>
          )
        }
      </nav>
    </header>
    <main id="main" class={`layout-${layout}`} tabindex="-1">
      <slot />
    </main>
    <footer class="colophon">
      <p class="notice">
        {st("layout.notice")}
        {pageLang !== "en" && (
          <span lang="en"> (Unofficial fan project. Not affiliated with or endorsed by Blizzard Entertainment.)</span>
        )}
      </p>
      <p>{st("layout.openSource")}</p>
      <p><a href={href("/privacy/")}>{st("layout.privacy")}</a></p>
      <p><a href={href("/terms/")}>{st("layout.terms")}</a></p>
      <p><a href={href("/accuracy/")}>{st("layout.accuracy")}</a></p>
    </footer>
  </body>
</html>
