---
import "../styles/global.css";
import { contentSecurityPolicy, readConfig } from "../lib/config.ts";

interface Props {
  title: string;
  description: string;
  /** Pages about one account are kept out of search engines. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Fails the build if only one setting is given or the key is not the public
// one; null means accounts are closed (no backend).
const config = readConfig(import.meta.env);
// Dev mode injects styles from JavaScript, which the policy would block; the
// built site (and `npm run preview`) always carries it.
const csp = import.meta.env.PROD ? contentSecurityPolicy(config?.url ?? null) : null;
const path = Astro.url.pathname;
// The 404 page answers on every missing address, so it names none.
const canonical = path.startsWith("/404") ? null : new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Tavern Ledger</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">TL</span>
        <span>Tavern Ledger</span>
      </a>
      <nav aria-label="Main">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
        {config && (
          <>
            <a href="/account/" aria-current={path.startsWith("/account") ? "page" : undefined}>Account</a>
            <a href="/signin/" aria-current={path.startsWith("/signin") ? "page" : undefined}>Sign in</a>
          </>
        )}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <p class="notice">
        Unofficial fan project. Not affiliated with or endorsed by Blizzard Entertainment.
      </p>
      <p>
        Open source (MIT). Not open to the public yet. <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>
      </p>
    </footer>
  </body>
</html>
