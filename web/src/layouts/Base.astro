---
import "../styles/global.css";
import { contentSecurityPolicy, readConfig } from "../lib/config.ts";

interface Props {
  title: string;
  description: string;
  /** Pages about one account are kept out of search engines. */
  noindex?: boolean;
  /** "home" is full width, "reading" one column of about 68 characters. */
  layout?: "home" | "page" | "reading";
}

const { title, description, noindex = false, layout = "page" } = Astro.props;
// Fails the build if only one setting is given or the key is not the public
// one; null means accounts are closed (no backend).
const config = readConfig(import.meta.env);
// Dev mode injects styles from JavaScript, which the policy would block; the
// built site (and `npm run preview`) always carries it.
const csp = import.meta.env.PROD ? contentSecurityPolicy(config?.url ?? null) : null;
const path = Astro.url.pathname;
// Pages kept out of search engines (404, sign-in, account) name no canonical address.
const canonical = noindex ? null : new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      layout === "home" && (
        <link
          rel="preload"
          href="/fonts/bricolage-grotesque-latin-wdth-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <title>{title} · Tavern Ledger</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="brand" href="/">
        <span class="mark" aria-hidden="true"></span>
        <span>Tavern Ledger</span>
      </a>
      <nav aria-label="Main">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
        <a href="/privacy/" aria-current={path.startsWith("/privacy") ? "page" : undefined}>Privacy</a>
        {config && (
          <>
            <a href="/signin/" aria-current={path.startsWith("/signin") ? "page" : undefined}>Sign in</a>
            <a href="/account/" aria-current={path.startsWith("/account") ? "page" : undefined}>Account</a>
          </>
        )}
      </nav>
    </header>
    <main id="main" class={`layout-${layout}`} tabindex="-1">
      <slot />
    </main>
    <footer class="colophon">
      <p class="notice">
        Unofficial fan project. Not affiliated with or endorsed by Blizzard Entertainment.
      </p>
      <p>Open source (MIT). Not open to the public yet.</p>
      <p><a href="/privacy/">Privacy</a></p>
      <p><a href="/terms/">Terms</a></p>
    </footer>
  </body>
</html>
