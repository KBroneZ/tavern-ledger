---
import Base from "../layouts/Base.astro";
import AccountsClosed from "../components/AccountsClosed.astro";
import PlayerStats from "../components/PlayerStats.astro";
import { readConfig } from "../lib/config.ts";

// With accounts closed the page shows a notice instead: no data, no script.
const accountsOpen = readConfig(import.meta.env) !== null;
---

<Base title="Heroes" description="A Tavern Ledger player's heroes: games, places and picks per hero." noindex>
  {accountsOpen ? <PlayerStats page="heroes" /> : <AccountsClosed heading="Heroes" />}
</Base>
