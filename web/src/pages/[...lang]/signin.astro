---
import Base from "../../layouts/Base.astro";
import AccountsClosed from "../../components/AccountsClosed.astro";
import SignIn from "../../components/SignIn.astro";
import { readConfig, signupsOpen } from "../../lib/config.ts";
import { langPaths, setLang } from "../../lib/i18n.ts";
import { st } from "../../lib/site/strings.ts";

export const getStaticPaths = langPaths;
// Every string below is drawn in the page's language (T-508).
setLang(Astro.props.lang);

// With accounts closed the page shows a notice instead: no form, no script.
const accountsOpen = readConfig(import.meta.env) !== null;
const canSignUp = signupsOpen(import.meta.env);
---

<Base backdrop="study" title={st("meta.signin.title")} description={st("meta.signin.description")} noindex turnstile>
  {accountsOpen ? <SignIn signupsOpen={canSignUp} /> : <AccountsClosed heading={st("meta.signin.title")} />}
</Base>
