---
import Base from "../layouts/Base.astro";
import AccountsClosed from "../components/AccountsClosed.astro";
import SignIn from "../components/SignIn.astro";
import { readConfig, signupsOpen } from "../lib/config.ts";

// With accounts closed the page shows a notice instead: no form, no script.
const accountsOpen = readConfig(import.meta.env) !== null;
const canSignUp = signupsOpen(import.meta.env);
---

<Base title="Sign in" description="Sign in or create a Tavern Ledger account." noindex>
  {accountsOpen ? <SignIn signupsOpen={canSignUp} /> : <AccountsClosed heading="Sign in" />}
</Base>
