---
import Base from "../layouts/Base.astro";
import { readConfig } from "../lib/config.ts";

const accountsOpen = readConfig(import.meta.env) !== null;

// The scene's five steps (D-052). The picture's description says the same
// as the captions together, for screen readers.
const steps = [
  { title: "Your screen, while you play", text: "Seen from the side, it comes apart into layers of glass." },
  { title: "The board", text: "Your minions. Drawn by the game, as always." },
  { title: "The tavern", text: "Where you buy. Also drawn by the game." },
  { title: "The leaderboard", text: "The eight heroes down the side, drawn by the game. Point at one." },
  {
    title: "Tavern Ledger, in front",
    text: "One pane of ours: a few notes at the side and the last board you met of the hero you point at. Only what you already saw, and your clicks pass through to the game.",
  },
];
const sceneLabel =
  "The game screen seen from the side, split into four panes of glass: the board, the tavern and the leaderboard, all drawn by the game, and Tavern Ledger's pane in front, lit, with a card for the hero pointed at and a few small notes. Drawn with our own simple shapes, no game art.";
---

<Base
  title="Your Battlegrounds games, kept for you"
  description="Free, open-source Battlegrounds tracker for Windows that only reads the game's log files, plus a website to follow your progress."
  layout="home"
>
  <section class="hero" aria-labelledby="hero-heading">
    <span class="lamp lamp-1" aria-hidden="true"></span>
    <span class="lamp lamp-2" aria-hidden="true"></span>
    <span class="lamp lamp-3" aria-hidden="true"></span>
    <h1 id="hero-heading">Pull up a stool. <em>We kept your games.</em></h1>
    <p class="lead">
      A free Windows app that reads Hearthstone's own log on your PC and keeps every Battlegrounds
      game: your hero, your place and the boards you faced.
    </p>
    <div class="ctas">
      <a class="btn" href="#scene">Show me</a>
      <a class="btn quiet" href="#safe">Is it safe?</a>
    </div>
  </section>

  <section class="pin" id="scene" aria-labelledby="scene-title">
    <h2 id="scene-title" class="visually-hidden">What Tavern Ledger adds to your screen</h2>
    <div class="pin-stage">
      <div class="caption-col">
        <div class="pips" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <ol class="captions">
          {
            steps.map((step, i) => (
              <li class={`cap c${i + 1}`}>
                <span class="step">{i + 1} of {steps.length}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="stage3d" role="img" aria-label={sceneLabel}>
        <div class="scene3">
          <div class="pane p1">
            <span class="label">Board</span>
            <div class="row"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="pane p2">
            <span class="label">Tavern</span>
            <div class="row"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="pane p3">
            <span class="label">Leaderboard</span>
            <div class="col"><i></i><i></i><i class="on"></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="pane p4 ours">
            <span class="label">Tavern Ledger</span>
            <span class="card"></span>
            <span class="beam"></span>
            <div class="panels-mini"><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="keeps-heading">
    <h2 id="keeps-heading" class="sec-h">What it keeps for you</h2>
    <p class="sec-p">
      Everything comes from the game's own log. When the log does not say, the app says "unknown"
      instead of guessing.
    </p>
    <div class="trio">
      <div class="glass">
        <span class="big">37<small>games kept, in this made-up example</small></span>
        <h3>Every game, every place</h3>
        <p>Your hero and where you finished, Solo and Duos apart.</p>
      </div>
      <div class="glass">
        <h3>The boards you met</h3>
        <p>Each opponent's board at the start of every combat, as the log records it.</p>
      </div>
      <div class="glass">
        <h3>A recap after each game</h3>
        <p>Your health over the rounds and your record against each opponent.</p>
      </div>
    </div>
  </section>

  <div class="sec">
    <section class="safe glass" id="safe" aria-labelledby="safe-heading">
      <div>
        <h2 id="safe-heading" class="sec-h">Safe for your account</h2>
        <p class="sec-p">It only reads the files the game already writes on your PC.</p>
      </div>
      <ul>
        <li>It never reads the game's memory, adds code to it or changes its files.</li>
        <li>It never plays or clicks for you.</li>
        <li>It never shows what you could not see on your own screen.</li>
      </ul>
    </section>
  </div>

  <section class="sec yours" aria-labelledby="yours-heading">
    <h2 id="yours-heading" class="sec-h">Your games stay yours</h2>
    <ul>
      <li><b>Private until you say</b><span>Your profile is hidden until you make it public.</span></li>
      <li><b>Take it all with you</b><span>Download everything the site keeps about you in one file.</span></li>
      <li><b>Gone when you ask</b><span>Delete your account and every game with it.</span></li>
    </ul>
  </section>

  <div class="sec">
    <aside class="doors glass" aria-label="Project status">
      <strong>The doors are not open yet.</strong>
      <span>
        The desktop app is a prototype and the website is being built.{" "}
        {accountsOpen ? "Accounts on this site are for testing only." : "Accounts are not open yet."}
      </span>
    </aside>
  </div>
</Base>
