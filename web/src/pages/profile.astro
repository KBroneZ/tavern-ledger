---
import Base from "../layouts/Base.astro";
import AccountsClosed from "../components/AccountsClosed.astro";
import PublicProfile from "../components/PublicProfile.astro";
import { readConfig } from "../lib/config.ts";

// With accounts closed the page shows a notice instead: no form, no script.
const accountsOpen = readConfig(import.meta.env) !== null;
---

<Base title="Player profile" description="A Tavern Ledger player's public games.">
  {accountsOpen ? <PublicProfile /> : <AccountsClosed heading="Player profile" />}
</Base>
