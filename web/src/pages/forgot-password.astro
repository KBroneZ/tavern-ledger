---
import Base from "../layouts/Base.astro";
import AccountsClosed from "../components/AccountsClosed.astro";
import ForgotPassword from "../components/ForgotPassword.astro";
import { readConfig } from "../lib/config.ts";

// With accounts closed the page shows a notice instead: no form, no script.
const accountsOpen = readConfig(import.meta.env) !== null;
---

<Base title="Forgot password" description="Choose a new password for your Tavern Ledger account." noindex>
  {accountsOpen ? <ForgotPassword /> : <AccountsClosed heading="Forgot password" />}
</Base>
