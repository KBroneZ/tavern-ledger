{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern Ledger overlay spike",
  "version": "0.0.0",
  "identifier": "dev.tavernledger.overlayspike",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Tavern Ledger overlay spike",
        "url": "index.html",
        "x": 100,
        "y": 100,
        "width": 420,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
