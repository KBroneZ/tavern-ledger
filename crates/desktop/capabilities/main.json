{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: its own commands and listening to app events only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-games",
    "allow-game-stats",
    "allow-curious-stats",
    "allow-period-overview",
    "allow-status",
    "allow-game-recap",
    "allow-game-why",
    "allow-preview-problem-report",
    "allow-save-problem-report",
    "allow-diagnostics-preview",
    "allow-lobby-tribes-view",
    "allow-edit-lobby-tribes",
    "allow-overlay-settings",
    "allow-overlay-set-theme",
    "allow-overlay-set-shown",
    "allow-overlay-set-odds",
    "allow-overlay-set-unlocked",
    "allow-overlay-set-enabled",
    "allow-overlay-asks-first",
    "allow-upload-status",
    "allow-upload-set-enabled",
    "allow-upload-sign-in",
    "allow-upload-cancel-sign-in",
    "allow-upload-sign-out",
    "allow-card-names",
    "allow-hero-groups",
    "allow-card-data-status",
    "allow-texture-set",
    "allow-game-memory-status",
    "allow-game-memory-set-enabled",
    "allow-app-settings",
    "allow-app-set-language",
    "allow-app-set-window-detail",
    "allow-app-set-system-language",
    "allow-app-autostart",
    "allow-app-set-autostart",
    "allow-game-folder-choose",
    "allow-game-folder-reset",
    "allow-game-folder-use-running",
    "allow-game-folder-decline-running",
    "allow-setup-recheck",
    "allow-setup-fix",
    "allow-log-ui-error",
    "allow-open-log-folder",
    "allow-update-status",
    "allow-update-set-auto",
    "allow-update-check-now",
    "allow-update-install",
    "allow-update-later"
  ]
}
