{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern Ledger",
  "version": "0.1.0",
  "identifier": "dev.tavernledger.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tavern Ledger",
        "url": "index.html",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "bundle": { "active": false }
}
